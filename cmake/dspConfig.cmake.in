@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(tl-expected CONFIG REQUIRED)
find_path(DSP_POCKETFFT_INCLUDE_DIR NAMES pocketfft_hdronly.h REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/@LIB_TARGET@Targets.cmake")
set_property(TARGET @LIB_TARGET@::@LIB_TARGET@ APPEND PROPERTY
    INTERFACE_INCLUDE_DIRECTORIES "${DSP_POCKETFFT_INCLUDE_DIR}"
)
